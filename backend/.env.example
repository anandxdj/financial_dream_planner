# development | test | production
NODE_ENV=development
# Express listen port
PORT=4000
# Local Postgres. docker compose publishes 5432
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auth_starter
# BullMQ coordination only; PostgreSQL remains canonical
REDIS_URL=redis://127.0.0.1:6379
# HS256 secret. Min 32 characters. Rotate in production
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-access-token-secret
# jsonwebtoken expiresIn string, e.g. 15m, 1h
ACCESS_TOKEN_EXPIRES_IN=15m
# Hashed refresh session TTL in Postgres
REFRESH_TOKEN_EXPIRES_DAYS=7
# Next.js origin. CORS allowlist + Google OAuth browser redirect after callback
WEB_ORIGIN=http://localhost:3000
# Public API origin. Must match PORT
API_ORIGIN=http://localhost:4000
# lax for localhost. none (and HTTPS) if API and web are different sites
COOKIE_SAMESITE=lax
# true = register does not set cookies until the email verify link is used
REQUIRE_EMAIL_VERIFICATION=false
# Authorized redirect in Google Cloud Console must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Leave SMTP_HOST empty to log verify/reset emails to the API console
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AUTH_ENABLED=true
REGISTRATION_ENABLED=true
CLOSED_BETA=false
OIDC_ENABLED=false
OIDC_ISSUER=https://github.com/anandxdj/id
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
# Comma-separated exact browser/mobile callback destinations
OIDC_ALLOWED_REDIRECTS=http://localhost:3000/auth/callback
OIDC_REAUTH_HOURS=24
COOKIE_DOMAIN=

# Private Cloudflare R2 / S3-compatible object storage. Keep disabled until all values are set.
STORAGE_ENABLED=false
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
